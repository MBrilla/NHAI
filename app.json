{
  "expo": {
    "name": "NailScan",
    "slug": "nailscan",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo.png",
    "scheme": "nailscan",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "NailScan needs access to your camera to scan nails.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "bundleIdentifier": "com.mbrilla.nailscan"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#EFF6FF",
        "foregroundImage": "./assets/images/logo.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/logo.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.mbrilla.nailscan",
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/android-icon-background.png",
          "imageWidth": 1,
          "resizeMode": "contain",
          "backgroundColor": "#EFF6FF"
        }
      ],
      "react-native-fast-tflite",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "888949f2-47af-404e-8414-8bd79dcfaf81"
      }
    }
  }
}
